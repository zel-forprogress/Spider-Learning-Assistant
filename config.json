        "claude": {
            "api_key": "",
            "default_model": "claude-sonnet-4-20250514",
            "available_models": ["claude-sonnet-4-20250514", "claude-haiku-4-20250414"]
        },
        "ollama": {
            "base_url": "http://localhost:11434",
            "default_model": "llama3.2",
            "available_models": []
        }
    }
