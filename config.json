{
    "ai": {
        "provider": "openai",
        "model": "gpt-4o",
        "max_tokens": 2048,
        "temperature": 0.7
    },
    "browser": {
        "poll_interval": 2.0,
        "max_content_tokens": 8000,
        "auto_crawl": true
    },
    "ui": {
        "window_x": 100,
        "window_y": 100,
        "window_width": 380,
        "window_height": 520,
        "collapsed_width": 120,
        "collapsed_height": 140,
